{
  "name": "spencer.dev",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash && . ~/.bashrc && bun install",
  "forwardPorts": [3000, 4173],
  "portsAttributes": {
    "3000": {
      "label": "Dev",
      "onAutoForward": "openBrowserOnce"
    },
    "4173": {
      "label": "Preview",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "editorconfig.editorconfig",
        "jacobcassidy.css-nesting-syntax-highlighting"
      ]
    }
  }
}
